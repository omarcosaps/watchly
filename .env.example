# Cole o API Read Access Token da TMDB (Bearer), não a API Key antiga
# Settings → API: https://www.themoviedb.org/settings/api
# Não use prefixo NEXT_PUBLIC_ — o token fica só no servidor
TMDB_ACCESS_TOKEN=

# Supabase (Auth + Postgres). Preferir a publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
